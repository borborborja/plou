# Copia este fichero a `.env` y ajusta lo que necesites.
# Ninguna variable es obligatoria: todas tienen un valor por defecto razonable.

# --- Servidor ---------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Carpeta de datos persistentes (base de datos y claves push).
PLOU_DATA_DIR=./data

# Servir la PWA compilada desde el propio servidor.
PLOU_SERVE_WEB=true
PLOU_WEB_DIST=../web/dist

# --- Avisos push ------------------------------------------------------------
# Genera las claves con `npm run keys`; se guardan en data/vapid.json.
# También se pueden pasar por entorno (tienen prioridad sobre el fichero).
PLOU_VAPID_SUBJECT=mailto:admin@localhost
# PLOU_VAPID_PUBLIC_KEY=
# PLOU_VAPID_PRIVATE_KEY=

# --- Vigilancia -------------------------------------------------------------
PLOU_ALARM_ENABLED=true
# Segundos entre ciclos de comprobación.
PLOU_ALARM_TICK=120
# Si el último fotograma de radar es más antiguo que esto (minutos), no se evalúa.
PLOU_ALARM_MAX_FRAME_AGE=30

# --- Radar ------------------------------------------------------------------
PLOU_RADAR_ZOOM=7
PLOU_RADAR_TILE_SIZE=512
PLOU_RADAR_TILE_CACHE=400
PLOU_RADAR_INDEX_TTL=120

# --- Previsión --------------------------------------------------------------
PLOU_FORECAST_TTL=600

# Foreca es un servicio comercial bajo licencia: el proveedor permanece
# desactivado mientras no se aporten credenciales propias.
#
# Modo `direct`: usuario y contraseña de developer.foreca.com.
# PLOU_FORECA_MODE=direct
# PLOU_FORECA_USER=
# PLOU_FORECA_PASSWORD=
#
# Modo `rapidapi`: clave de la pasarela de RapidAPI.
# PLOU_FORECA_MODE=rapidapi
# PLOU_FORECA_RAPIDAPI_KEY=
# PLOU_FORECA_RAPIDAPI_HOST=foreca-weather.p.rapidapi.com
