# Copia este fichero a `.env` y ajusta lo que necesites.
# Ninguna variable es obligatoria: todas tienen un valor por defecto razonable.

# --- Servidor ---------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Carpeta de datos persistentes (base de datos y claves push).
PLOU_DATA_DIR=./data
# Ruta alternativa para SQLite y para el fichero de claves push.
# PLOU_DB=./data/plou.db
# PLOU_VAPID_FILE=./data/vapid.json

# Servir la PWA compilada desde el propio servidor.
PLOU_SERVE_WEB=true
PLOU_WEB_DIST=../web/dist

# --- Protección de una instancia expuesta ---------------------------------
# Sin valor, la API sólo publica cabeceras CORS para el mismo origen.
# PLOU_CORS_ORIGINS=https://plou.example.com,https://otra.example.com
# Actívalo sólo detrás de un proxy propio que reescriba X-Forwarded-For.
PLOU_TRUST_PROXY=false
PLOU_RATE_LIMIT_PER_MINUTE=300
PLOU_MAX_DEVICES=100
PLOU_MAX_LOCATIONS_PER_DEVICE=20
# Si se define, un navegador nuevo debe abrir una vez `/?invite=este-valor`.
# PLOU_REGISTRATION_TOKEN=cambia-esto-por-un-secreto-largo

# --- Avisos push ------------------------------------------------------------
# Genera las claves con `npm run keys`; se guardan en data/vapid.json.
# También se pueden pasar por entorno (tienen prioridad sobre el fichero).
PLOU_VAPID_SUBJECT=mailto:admin@localhost
# PLOU_VAPID_PUBLIC_KEY=
# PLOU_VAPID_PRIVATE_KEY=

# --- Vigilancia -------------------------------------------------------------
PLOU_ALARM_ENABLED=true
# Segundos entre ciclos de comprobación.
PLOU_ALARM_TICK=120
# Si el último fotograma de radar es más antiguo que esto (minutos), no se evalúa.
PLOU_ALARM_MAX_FRAME_AGE=30
# La PWA debe haber sincronizado "mi posición" dentro de esta ventana.
PLOU_DEVICE_POSITION_MAX_AGE=30

# --- Radar ------------------------------------------------------------------
PLOU_RADAR_ZOOM=7
PLOU_RADAR_TILE_SIZE=512
PLOU_RADAR_TILE_CACHE=400
PLOU_RADAR_TILE_CACHE_MB=128
PLOU_RADAR_INDEX=https://api.rainviewer.com/public/weather-maps.json
PLOU_RADAR_INDEX_TTL=120
PLOU_RADAR_TILE_TIMEOUT=12000

# --- Capas meteorológicas del mapa -----------------------------------------
# Satélite EUMETSAT: no necesita clave. El WMS y la historia son configurables.
PLOU_EUMET_WMS_URL=https://view.eumetsat.int/geoserver/wms
PLOU_SATELLITE_HISTORY_MINUTES=120

# Previsión de nubosidad total (OpenWeather Weather Maps 2.0, capa CL).
# Sin clave la opción aparece desactivada; la clave no llega al navegador.
# PLOU_OPENWEATHER_API_KEY=
PLOU_OPENWEATHER_TILES_URL=https://maps.openweathermap.org/maps/2.0/weather

# Mapa agregado de rayos nube-tierra de las últimas 12 h (AEMET OpenData).
# Es una capa informativa aproximada, no un sistema de alertas.
# PLOU_AEMET_API_KEY=
PLOU_AEMET_LIGHTNING_URL=https://opendata.aemet.es/opendata/api/red/rayos/mapa
# Calibración geográfica/crop del PNG AEMET: oeste,sur,este,norte y x,y,w,h (0..1).
PLOU_AEMET_LIGHTNING_BOUNDS=-19,27,5,45
PLOU_AEMET_LIGHTNING_CROP=0,0,1,1

PLOU_MAP_TILE_CACHE=512
PLOU_MAP_TILE_TIMEOUT=15000

# --- Previsión --------------------------------------------------------------
PLOU_FORECAST_TTL=600
PLOU_OPENMETEO_URL=https://api.open-meteo.com/v1/forecast
PLOU_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Foreca es un servicio comercial bajo licencia: el proveedor permanece
# desactivado mientras no se aporten credenciales propias.
#
# Modo `direct`: usuario y contraseña de developer.foreca.com.
# PLOU_FORECA_MODE=direct
# PLOU_FORECA_USER=
# PLOU_FORECA_PASSWORD=
# PLOU_FORECA_BASE_URL=https://pfa.foreca.com
# PLOU_FORECA_AUTH_URL=https://pfa.foreca.com/authorize/token
#
# Modo `rapidapi`: clave de la pasarela de RapidAPI.
# PLOU_FORECA_MODE=rapidapi
# PLOU_FORECA_RAPIDAPI_KEY=
# PLOU_FORECA_RAPIDAPI_HOST=foreca-weather.p.rapidapi.com

# Identificación enviada a proveedores externos.
# PLOU_USER_AGENT=Plou/1.0 (rain alarm; +https://tu-dominio.example)
